clear
if(!require(car)){install.packages("car")}
if(!require(lmtest)){install.packages("lmtest")}
if(!require(rcompanion)){install.packages("rcompanion")}
# Load data
df <- read.csv("JAMA_logistic_regression_data.csv")
# Install packages if needed
if(!require(car)){install.packages("car")}
if(!require(lmtest)){install.packages("lmtest")}
if(!require(rcompanion)){install.packages("rcompanion")}
# Load data
df <- read.csv("/Users/alexadisabato/Desktop/Mount Sinai/Dr. Clair Kronk Lab/JAMA_logistic_regression_data.csv")
# Run logistic regression
# outcome = hit_by_disaster, predictor = has_drug_facility
model <- glm(hit_by_disaster ~ has_drug_facility,
data = df,
family = binomial(link = "logit"))
# View results
summary(model)
# Odds ratio
exp(model$coefficients)
# Odds ratio with 95% confidence intervals
exp(cbind(OR = coef(model), confint(model)))
# Test significance of the predictor
library(car)
Anova(model, type = "II", test = "Wald")
# Overall model p-value
anova(model, update(model, ~1), test = "Chisq")
# Pseudo R-squared
library(rcompanion)
nagelkerke(model)
